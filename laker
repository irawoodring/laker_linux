#!/usr/bin/env bash
#
# LakerLinux front door.
#
#   ./laker build [--lfs | --busybox] [--gui] [stage...]
#                              build kernel + userland + disk image (inside Docker)
#                              --lfs / --busybox: which system (see below)
#                              --gui: the LFS system plus a graphical desktop:
#                              the pane display server and the foot terminal
#   ./laker run [--direct] [--usb | --boot-usb] [--gui]
#                              boot out/lakerlinux.img in QEMU (--usb: with a
#                              virtual USB stick to install to; --gui: in a
#                              window, using your own QEMU; see README.md)
#   ./laker lfs status|download|redo <step> [--gui]
#                              Linux From Scratch steps (--gui: count the
#                              desktop's steps too)
#   ./laker shell              a shell inside the build container
#   ./laker diff [<component> [name]]
#                              show your source edits, or save them as a patch
#   ./laker reset <component>  throw away source edits you haven't saved
#   ./laker clean              delete build output (keeps downloads)
#
# Components: kernel, glibc, busybox, binutils, gcc, tcc, make, util-linux,
# e2fsprogs.
#
# The system is BusyBox unless you say --lfs (or set SYSTEM=lfs). The desktop
# is only built when you say --gui (or set GUI=yes). The busybox system's
# compiler: COMPILER=gcc (default), tcc or both, e.g.
#   COMPILER=tcc ./laker build
#   ./laker build --lfs
#   ./laker build --gui
#
# Set LAKER_NATIVE=1 to skip Docker and use your own Linux toolchain
# (see README.md for the package list).

set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"

cmd="${1:-help}"; shift || true

# Flags that stand for settings: --lfs / --busybox for SYSTEM, --gui for GUI.
# (run has its own --gui, for a window, so it's left alone.) Everything else
# goes through to the script. "${a[@]+...}": macOS's bash 3.2 calls an empty
# array unbound under `set -u`.
args=()
want_busybox=0
for a in "$@"; do
    case "$cmd:$a" in
        build:--lfs)     SYSTEM=lfs ;;
        build:--busybox) SYSTEM=busybox; want_busybox=1 ;;
        build:--gui|lfs:--gui) GUI=yes ;;
        *) args+=("$a") ;;
    esac
done
set -- ${args[@]+"${args[@]}"}
if [ "${GUI:-}" = yes ] && [ "$cmd" = build ]; then
    # the desktop is part of the LFS system
    [ "$want_busybox" = 0 ] || { echo "--gui builds the LFS system; it can't go with --busybox." >&2; exit 1; }
    SYSTEM=lfs
fi

# SYSTEM: from the flags or the command line, else its default in
# config/versions.sh. (Everything else in that file is read inside the container.)
SYSTEM="${SYSTEM:-$(sed -n 's/^SYSTEM="${SYSTEM:-\(.*\)}"$/\1/p' config/versions.sh)}"
if [ "$cmd" = lfs ]; then SYSTEM=lfs; fi   # ./laker lfs ... is always about LFS
export SYSTEM   # for LAKER_NATIVE=1 builds, which run the scripts directly
[ -z "${GUI:-}" ] || export GUI

# Each system has its own Docker image and build volume. The build lives in a
# volume: faster than your own disk, and macOS's case-insensitive filesystem
# can't hold the kernel tree.
case "$SYSTEM" in
    busybox)
        IMAGE=lakerlinux-builder
        VOLUME=lakerlinux-build
        DOCKER_OPTS=(--rm -i) ;;
    lfs)
        # Always an x86_64 container: the LFS build runs the new system's
        # programs in a chroot. On Apple Silicon, Docker Desktop emulates x86_64.
        # --privileged: the chroot needs /dev, /proc and /sys mounted.
        IMAGE=lakerlinux-lfs-builder
        VOLUME=lakerlinux-lfs-build
        DOCKER_OPTS=(--rm -i --platform linux/amd64 --privileged) ;;
    *) echo "SYSTEM must be busybox or lfs (not \"$SYSTEM\")" >&2; exit 1 ;;
esac

in_env() {
    if [ "${LAKER_NATIVE:-0}" = 1 ]; then
        "$@"
        return
    fi
    command -v docker >/dev/null || { echo "Docker not found. Install Docker, or set LAKER_NATIVE=1." >&2; exit 1; }
    if [ "$SYSTEM" = lfs ]; then
        docker build -q --platform linux/amd64 -t "$IMAGE" . >/dev/null
    else
        docker build -q -t "$IMAGE" . >/dev/null
    fi
    # One array that's never empty: macOS ships bash 3.2, which treats an
    # empty "${array[@]}" as an unbound variable under `set -u`.
    local opts=("${DOCKER_OPTS[@]}")
    [ -t 0 ] && opts+=(-t)
    [ -e /dev/kvm ] && opts+=(--device /dev/kvm)   # Linux hosts only
    # Pass through the settings people override on the command line,
    # e.g. `MEM=2G ./laker run` (see config/versions.sh and scripts/run.sh).
    local v
    opts+=(-e "SYSTEM=$SYSTEM")
    for v in COMPILER GUI JOBS MEM KERNEL_VERSION KERNEL_URL GLIBC_VERSION GLIBC_URL BUSYBOX_VERSION BUSYBOX_URL TCC_COMMIT TCC_URL LFS_MIRROR IMAGE_SIZE_MB; do
        if [ -n "${!v:-}" ]; then opts+=(-e "$v=${!v}"); fi
    done
    docker run "${opts[@]}" \
        -v "$PWD:/lakerlinux" -v "$VOLUME:/build" -e BUILD_DIR=/build \
        -e HOST_UID="$(id -u)" -e HOST_GID="$(id -g)" \
        "$IMAGE" "$@"
}

case "$cmd" in
    build) in_env scripts/build.sh "$@" ;;
    run)
        # A window can't open from inside the container, so --gui runs your
        # own QEMU (brew install qemu, or apt install qemu-system-x86 ovmf).
        case " $* " in
            *" --gui "*)
                command -v qemu-system-x86_64 >/dev/null || { echo "--gui needs QEMU installed on this computer (brew install qemu, or apt install qemu-system-x86 ovmf)." >&2; exit 1; }
                scripts/run.sh "$@" ;;
            *) in_env scripts/run.sh "$@" ;;
        esac ;;
    lfs)   in_env scripts/lfs.sh "$@" ;;
    shell) in_env bash ;;
    diff)  in_env scripts/source.sh diff "$@" ;;
    reset) in_env scripts/source.sh reset "$@" ;;
    clean)
        rm -rf out
        in_env bash -c 'b="${BUILD_DIR:-build}"; rm -rf "$b/src" "$b/rootfs" "$b"/*.img "$b/kernel.fragment" "$b/sysroot" "$b/kernel-headers" "$b"/glibc-build-* "$b"/cross* "$b"/devtools* "$b/tcc-build" "$b"/make-build-* "$b"/util-linux-build-* "$b"/e2fsprogs-build-* "$b/initramfs" "$b/lfs" "$b/lfs-done" "$b/lfs-logs" "$b"/zlib-build "$b"/openssl-build "$b"/curl-build "$b"/git-build"';;
    *) sed -n '3,33p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
