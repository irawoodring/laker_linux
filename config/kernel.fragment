# LakerLinux kernel options, merged on top of the architecture defconfig.
# Add an option here, then run `./laker build kernel` to rebuild.

CONFIG_LOCALVERSION="-laker"
# The source tree is a git repo (see patches/README.md); don't append a
# commit ID to the version.
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_DEFAULT_HOSTNAME="lakerlinux"

# Expose the running config at /proc/config.gz -- handy for exploring.
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# Let the kernel populate /dev itself so we don't need udev.
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Boot straight from UEFI firmware: the kernel *is* the bootloader.
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_PARTITION=y
CONFIG_CMDLINE_BOOL=y
# CMDLINE is filled in by scripts/build.sh from config/versions.sh.

# The initramfs (initramfs/), built into the kernel. INITRAMFS_SOURCE is
# filled in by scripts/build.sh.
CONFIG_BLK_DEV_INITRD=y

# Filesystems
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_TMPFS=y

# Disks and network for QEMU (virtio) and common real hardware.
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_SCSI_VIRTIO=y
CONFIG_BLK_DEV_NVME=y
CONFIG_SATA_AHCI=y
CONFIG_E1000=y
CONFIG_E1000E=y

# USB disks and keyboards, for booting from (and installing to) USB sticks
# on real PCs.
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_PCI=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_PCI=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y

# Console on a framebuffer when booted on a real machine.
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# Linux From Scratch's requirements (book section 10.3), beyond the above.
CONFIG_PSI=y
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_RELOCATABLE=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
# CONFIG_UEVENT_HELPER is not set
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_X86_X2APIC=y
CONFIG_PCI_MSI=y
