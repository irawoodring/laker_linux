# /etc/inittab -- read by BusyBox init (PID 1). Format: id::action:command
::sysinit:/etc/init.d/rcS

# A login prompt on the serial console (what `./laker run` shows you) and on
# the first virtual terminal (what a monitor shows on real hardware).
ttyS0::respawn:/sbin/getty -L 115200 ttyS0 vt100
tty1::respawn:/sbin/getty 38400 tty1

::ctrlaltdel:/sbin/reboot
::shutdown:/etc/init.d/rcK
